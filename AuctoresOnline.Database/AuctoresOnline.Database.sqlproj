    <Build Include="dbo\Tables\TempCkeditorImages.sql" />
    <Build Include="dbo\Tables\TempExternalImages.sql" />
    <!-- Tables that depend on Journals -->
    <Build Include="dbo\Tables\AbstractingIndexing.sql" />
    <Build Include="dbo\Tables\Articles.sql" />
    <Build Include="dbo\Tables\ArticleProcessingCharges.sql" />
    <Build Include="dbo\Tables\JournalEditorialBoard.sql" />
