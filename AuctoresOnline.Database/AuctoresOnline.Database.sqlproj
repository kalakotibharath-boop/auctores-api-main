    <!-- Tables that depend on Articles -->
    <Build Include="dbo\Tables\ArticleAuthors.sql" />
    <Build Include="dbo\Tables\ArticleDetails.sql" />
    <Build Include="dbo\Tables\ArticleReferences.sql" />
    <!-- Tables that depend on Journals + Authors -->
    <Build Include="dbo\Tables\Manuscripts.sql" />
    <!-- Tables that depend on Manuscripts + Authors -->
    <Build Include="dbo\Tables\ManuscriptAuthors.sql" />
    <!-- Special issues -->
    <Build Include="dbo\Tables\SpecialIssues.sql" />
    <Build Include="dbo\Tables\SpecialIssuesEditors.sql" />
    <Build Include="dbo\Tables\SpecialIssueRequest.sql" />
    <!-- Subscription -->
    <Build Include="dbo\Tables\SubscriptionList.sql" />
  </ItemGroup>
  <ItemGroup>
