    <!-- Manuscript views -->
    <Build Include="dbo\Views\vw_Manuscripts.sql" />
    <Build Include="dbo\Views\vw_ManuscriptAuthors.sql" />
    <Build Include="dbo\Views\vw_ManuscriptRequest.sql" />
    <!-- Misc views -->
    <Build Include="dbo\Views\vw_MemberedIn.sql" />
    <Build Include="dbo\Views\vw_MemberRequest.sql" />
    <Build Include="dbo\Views\vw_PubmedIndex.sql" />
